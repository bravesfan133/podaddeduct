# PodAdDeduct — only deployment settings live here.
# Everything else (AI key, transcription, processing, storage,
# public address, password) is configured in the web UI.
# Each item below can still override the UI if you really want it to.
DATA_DIR=./data
HOST=0.0.0.0
PORT=8080
# NOTE: the Docker server runs on 7887 (see compose.yaml). This PORT is only
# for local Mac dev.

# --- Advanced overrides (normally leave commented out) ---
# PUBLIC_BASE_URL=https://podcasts.example.com
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_API_KEY=gsk_...
# STT_PYTHON=python
# STT_SIDECAR=./scripts/stt_groq.py
# STT_MODEL=whisper-large-v3-turbo
# APP_PASSWORD=change-me
