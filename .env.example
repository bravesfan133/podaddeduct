# Phone-reachable base URL. LAN example: http://192.168.0.93:8080
# Leave empty to auto-detect your LAN IP. For use outside home Wi-Fi,
# put a Cloudflare Tunnel https URL here later (no VPS needed).
PUBLIC_BASE_URL=

# OpenCode Zen API key (or paste in the web UI → saved to data/secrets.json)
# OPENCODE_API_KEY=sk-...
# ZEN_API_KEY=sk-...
# ZEN_MODEL=muse-spark-1.3-contributor-free

# Transcription backend.
# Mac dev default (Apple Silicon Parakeet sidecar):
STT_PYTHON=./.venv-stt/bin/python
STT_SIDECAR=./scripts/stt_sidecar.py
STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# Linux / Docker: compose.yaml already overrides these with the
# N100-friendly faster-whisper backend (STT_MODEL=tiny|base|small).
# STT_PYTHON=python
# STT_SIDECAR=./scripts/stt_faster.py
# STT_MODEL=base

# Storage: small cache, not an archive
MAX_CACHE_GB=3.0
KEEP_LAST_N=5
DELETE_AFTER_DAYS=14
DELETE_ORIGINAL_AFTER_CUT=true
POLL_MINUTES=30
AUTO_PREPARE_LATEST=true

PROCESS_RECENT=3
FEED_ITEM_LIMIT=40
MIN_AD_SECONDS=8
DATA_DIR=./data
HOST=0.0.0.0
PORT=8080
# Optional family password when exposed via tunnel. Empty = no login at home.
# APP_PASSWORD=change-me
