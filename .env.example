# PodAdDeduct — only deployment settings live here.
# Everything else (AI key + model, transcription, processing, storage,
# public address, password) is configured in the web UI on the home page.
# Each item below can still override the UI if you really want it to.
DATA_DIR=./data
HOST=0.0.0.0
PORT=8080
# NOTE: the Docker server runs on 7887 (see compose.yaml). This PORT is only
# for local Mac dev.

# --- Advanced overrides (normally leave commented out) ---
# PUBLIC_BASE_URL=https://podcasts.example.com
# OPENCODE_API_KEY=sk-...
# ZEN_MODEL=muse-spark-1.3-contributor-free
# ZEN_FALLBACK_MODEL=deepseek-v4-flash-free
# STT_PYTHON=./.venv-stt/bin/python
# STT_SIDECAR=./scripts/stt_sidecar.py
# STT_MODEL=mlx-community/parakeet-tdt-0.6b-v3
# APP_PASSWORD=change-me
